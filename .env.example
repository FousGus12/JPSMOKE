# Variables públicas (van al navegador por diseño). Nunca poner aquí service_role ni tokens.
# Local: scripts/db-local.sh escribe .env.local con los valores de `supabase status`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
PUBLIC_SUPABASE_ANON_KEY=
# Restaurante que sirve este despliegue (D24: base compartida; un despliegue por restaurante).
PUBLIC_RESTAURANT_SLUG=jp-smoke
# Clave pública de Cloudflare Turnstile (la secreta va solo como secreto de la Edge Function).
PUBLIC_TURNSTILE_SITE_KEY=
# URL pública del sitio (canonical, sitemap, Open Graph).
SITE_URL=https://jp-smoke.vercel.app
# Indexar en buscadores: false hasta el lanzamiento (F10).
SITE_INDEXABLE=false
