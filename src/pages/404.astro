---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe." noindex>
  <main class="mx-auto grid min-h-dvh max-w-[var(--page-max)] content-center gap-6 px-[var(--gutter)]">
    <p class="eyebrow">Error 404</p>
    <h1 class="display text-6xl">Esta página no existe</h1>
    <a class="btn btn-primary w-fit" href="/">
      Volver al inicio
    </a>
  </main>
</Base>
