---
import { LOGO_VIEWBOX, logoShapes } from '../lib/logo';

interface Props {
  name: string;
}
const [first, ...rest] = Astro.props.name.split(' ');
const shapes = logoShapes();
---

<span class="logo-mark" aria-hidden="true">
  <svg viewBox={LOGO_VIEWBOX}>
    {shapes.map((shape) => (shape.tag === 'rect' ? <rect {...shape.attrs} /> : <path {...shape.attrs} />))}
  </svg>
</span>
<b>
  {first} <i>{rest.join(' ')}</i>
</b>
