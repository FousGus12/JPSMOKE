---
import { formatCop } from '../../core/money';
import type { Product } from '../../lib/content';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

{product.comboPrice === null ? (
  <div class="price-one">{formatCop(product.price)}</div>
) : (
  <div class="variant" role="group" aria-label="Presentación">
    <button type="button" data-variant={product.id} data-combo="0" aria-pressed="true">
      <small>Sola</small>
      <b>{formatCop(product.price)}</b>
    </button>
    <button type="button" data-variant={product.id} data-combo="1" aria-pressed="false">
      <small>Combo</small>
      <b>{formatCop(product.comboPrice)}</b>
    </button>
  </div>
)}
