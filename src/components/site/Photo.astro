---
/**
 * Foto adaptable (D51): <picture> con AVIF y WebP por tamaño. Si la foto no se puede optimizar,
 * pinta el <img> de siempre con la URL original.
 * `deferred`: no descarga nada hasta que sitio.ts copie data-src/data-srcset (bienvenida).
 */
import { responsivePhoto, type PhotoPreset } from '../../lib/images';

interface Props {
  src: string | null | undefined;
  preset: PhotoPreset;
  alt?: string;
  class?: string;
  priority?: boolean;
  deferred?: boolean;
  /** Medidas del <img> simple cuando no hay versiones. */
  width?: number;
  height?: number;
}
const {
  src,
  preset,
  alt = '',
  class: className,
  priority = false,
  deferred = false,
  width,
  height,
} = Astro.props;
const photo = await responsivePhoto(src, preset);
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
const decoding = priority ? undefined : 'async';
---

{src &&
  (photo ? (
    <picture>
      {photo.sources.map((source) =>
        deferred ? (
          <source type={source.type} data-srcset={source.srcset} sizes={photo.sizes} />
        ) : (
          <source type={source.type} srcset={source.srcset} sizes={photo.sizes} />
        ),
      )}
      {deferred ? (
        <img class={className} data-src={photo.src} alt={alt} width={photo.width} height={photo.height} />
      ) : (
        <img
          class={className}
          src={photo.src}
          alt={alt}
          width={photo.width}
          height={photo.height}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding={decoding}
        />
      )}
    </picture>
  ) : deferred ? (
    <img class={className} data-src={src} alt={alt} width={width} height={height} />
  ) : (
    <img
      class={className}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  ))}
